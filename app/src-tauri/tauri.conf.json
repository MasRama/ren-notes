{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renotes",
  "mainBinaryName": "renotes",
  "version": "../package.json",
  "identifier": "io.github.masrama.Renotes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Renotes",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' renotes: http://renotes.localhost data: blob:; media-src 'self' renotes: http://renotes.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "publisher": "MasRama",
    "homepage": "https://github.com/MasRama/ren-notes",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Notes for Linux and Windows with the calm feel of Notes on the Mac",
    "longDescription": "Folders, checklists, tables, pictures, tags, smart folders and fast search, kept in one local library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "editors"
      }
    }
  }
}
